# Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./backend/liking_rating_db.db
DATABASE_TEST_URL=sqlite+aiosqlite:///./backend/test_liking_rating_db.db

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379

# OSF Configuration (optional, for data sync)
OSF_API_TOKEN=your_osf_api_token_here
OSF_PROJECT_ID=your_osf_project_id_here

# API Configuration
SECRET_KEY=liking-rating-db-secure-key-2025
API_V1_STR=/api/v1
PROJECT_NAME=Liking Rating Database
API_HOST=localhost
API_PORT=8000

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# File Upload Configuration
MAX_UPLOAD_SIZE=100  # MB
ALLOWED_EXTENSIONS=[".csv", ".xlsx", ".sav", ".json"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Email Configuration (for notifications - optional)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=admin@likingratings.org
SMTP_PASSWORD=your_app_password
