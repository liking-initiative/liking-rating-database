# Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# For development (SQLite at the repo root)
DATABASE_URL=sqlite+aiosqlite:///./data/liking_rating_db.db
DATABASE_TEST_URL=sqlite+aiosqlite:///./test_liking_rating_db.db

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Liking Rating Database
API_HOST=localhost
API_PORT=8000

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Trusted Hosts (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1

# Logging (stdout is always used; set LOG_FILE to also write to a file)
LOG_LEVEL=INFO
# LOG_FILE=app.log

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100
